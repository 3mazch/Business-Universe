# ============================================================
# SQL Server Connection Settings for FlexCoffeeTea DB Loader
# ============================================================
# Copy file này thành .env và điền thông tin thực của bạn.
# KHÔNG commit file .env thật vào git.

# --- Recommended for local development: Windows Authentication ---
DB_SERVER=localhost
DB_NAME=FlexCoffeeTea
DB_TRUSTED=yes

# --- Hoặc SQL Server Authentication ---
# DB_USER=your_login
# DB_PASSWORD=your_password

# Chỉ đặt DB_PORT nếu SQL Server đã được cấu hình dùng TCP port cố định.
# Để trống/unset DB_PORT với local default instance hoặc named instance.
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 17 for SQL Server
